<Project Sdk="Microsoft.NET.Sdk">

  <!-- The KPI copy from a developer's machine: refreshes the local KPI_Export as the office's Agent jobs would, then runs
       the same copy as the site (Kpi.Copy) into your local CMS_KPI (only a local one). In production the site
       itself copies, from KPI_Export on the office server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- a label, not a secret: each developer's connection strings live in their own profile, outside the repo -->
    <UserSecretsId>4e8b2a7d-1c3f-4b9a-a6d2-7f0e5c1b9d84</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kpi.Copy\Kpi.Copy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
