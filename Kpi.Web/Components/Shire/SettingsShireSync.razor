@using Kpi.Web.Data
@using Kpi.Data.Auth
@using Kpi.Web.Shire
@using Kpi.Web.Components.Pages.Settings
@inject KpiSessionFactory Sessions
@inject ShireFiguresSignal Figures
@inject ShireCopyControl Copy
@inject IServiceScopeFactory Scopes
@implements IDisposable

@* Settings > Shire sync (3 Nov 2026, Steve: "an extra data sync item just for Shire Salesforce"), beside Data sync for the
   CMS copy: when the site last checked Shire's Salesforce and last copied, pause / how often / Copy now (ShireCopyControl),
   and the recent copies with any errors (Shire.LoadRun, through Shire.spDataStatus / Shire.spLoadHistory). A check that
   finds nothing new in Salesforce isn't listed - only copies and failures are. *@

<div class="set-head">
    <div>
        <h2>Shire sync</h2>
        <p class="acc-hint">The site checks Shire's Salesforce every @EveryText and copies the won deals when anything there has changed
           (Settings &gt; Integrations &gt; Salesforce). Only what the Shire reports use is copied.</p>
    </div>
    <button type="button" class="acc-btn-secondary" disabled="@_loading" @onclick="RefreshAll"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>

@if (_error is not null)
{
    <div class="login-error" role="alert"><i class="bi bi-exclamation-triangle-fill"></i> @_error</div>
}
@if (_status is not null)
{
    <div class="set-tiles">
        <div class="set-tile @(_status.Stale ? "set-tile-bad" : "")">
            <span class="set-tile-label">Last check</span>
            <span class="set-tile-value">@UkTime.Show(_status.LastCheckUtc)</span>
            <span class="set-tile-note">@(_status.Stale ? "Overdue: more than 45 minutes ago, in office hours" : "Salesforce asked whether anything changed")</span>
        </div>
        <div class="set-tile">
            <span class="set-tile-label">Last copy</span>
            <span class="set-tile-value">@UkTime.Show(_status.LastCopyUtc)</span>
            <span class="set-tile-note">@(_status.SaleCount is int n ? $"{n:N0} won deals" : "Not copied yet")</span>
        </div>
        <div class="set-tile">
            <span class="set-tile-label">Salesforce last changed</span>
            <span class="set-tile-value">@UkTime.Show(_status.SourceChangedUtc)</span>
            <span class="set-tile-note">The newest change in the data copied</span>
        </div>
    </div>
}

@if (_schedule is not null)
{
    <div class="set-alerts set-copy">
        <div class="set-alerts-head">
            <h3>Copying</h3>
            @if (Copy.Running)
            {
                <span class="set-running"><span class="set-pulse" aria-hidden="true"></span>Checking now (since @UkTime.Show(Copy.RunningSinceUtc, "HH:mm:ss"))</span>
            }
            else if (_schedule.Paused)
            {
                <span class="set-pill set-pill-switchedoff"><i class="bi bi-pause-fill"></i> Paused</span>
            }
            else
            {
                <span class="set-pill set-pill-active"><i class="bi bi-play-fill"></i> On</span>
            }
        </div>
        @if (_schedule.Paused)
        {
            <p class="set-sub">Paused by @_schedule.PausedBy at @UkTime.Show(_schedule.PausedUtc, "HH:mm 'on' dd MMM")@(_schedule.PausedReason is null ? "" : $": {_schedule.PausedReason}").
               The Shire reports keep the figures they have until it's resumed. Copy now still works.</p>
        }
        else if (!Copy.Running && Copy.NextCheckUtc is { } next)
        {
            <p class="set-sub">Next check at @UkTime.Show(next, "HH:mm:ss"): a copy only when something in Salesforce has changed since the last one.
               @if (Copy.LastResult is { } last) { <span>Last check: @last</span> }</p>
        }
        <div class="set-copy-row">
            <label class="set-copy-every">Check every
                <select value="@_schedule.EveryMinutes" @onchange="ChangeEvery" disabled="@_busy">
                    @foreach (var m in ShireCopyControl.EveryChoices) { <option value="@m">@m minutes</option> }
                </select>
            </label>
            <button type="button" class="acc-btn" disabled="@(_busy || Copy.PendingBy is not null)" @onclick="CopyNow"
                    title="Copy now, even if nothing in Salesforce has changed - to check the copy works">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Copy now
            </button>
            @if (_schedule.Paused)
            {
                <button type="button" class="acc-btn-secondary" disabled="@_busy" @onclick="Resume"><i class="bi bi-play-fill" aria-hidden="true"></i> Resume</button>
            }
            else
            {
                <input class="set-copy-reason" @bind="_pauseReason" placeholder="Reason (optional)" maxlength="200" aria-label="Reason for pausing" />
                <button type="button" class="acc-btn-secondary" disabled="@_busy" @onclick="Pause"><i class="bi bi-pause-fill" aria-hidden="true"></i> Pause</button>
            }
        </div>
        @if (Copy.PendingBy is not null)
        {
            <p class="set-sub">Copy now asked for by @Copy.PendingBy: it starts @(Copy.Running ? "when the check running now finishes" : "in a moment").</p>
        }
        else if (Copy.LastManual is { } m)
        {
            <p class="@(m.Ok == false ? "set-copy-bad" : "set-sub")">
                Copy now by @m.By at @UkTime.Show(m.RequestedUtc, "HH:mm:ss"):
                @(m.Result ?? "copying…")
            </p>
        }
    </div>
}

@if (_runs is not null)
{
    <div class="set-table-wrap">
        <table class="set-table">
            <thead>
                <tr>
                    <th>Started</th>
                    <th class="set-part">Copied</th>
                    <th>Won deals</th>
                    <th>Took</th>
                    <th>Info</th>
                </tr>
            </thead>
            <tbody>
                @if (_runs.Count == 0)
                {
                    <tr><td colspan="5" class="set-sub">No copies yet.</td></tr>
                }
                @foreach (var r in _runs)
                {
                    <tr>
                        <td>@UkTime.Show(r.StartedUtc, "dd MMM HH:mm:ss")</td>
                        <td class="set-part">
                            @if (r.Succeeded == true) { <i class="bi bi-check-lg set-part-ok" title="Copied" aria-label="Copied"></i> }
                            else if (r.Succeeded == false) { <i class="bi bi-x-lg set-part-bad" title="Failed - see Info" aria-label="Failed"></i> }
                            else { <span class="set-running" title="Copying now"><span class="set-pulse" aria-hidden="true"></span>Running</span> }
                        </td>
                        <td>@(r.SaleCount is int c ? c.ToString("N0") : "-")</td>
                        <td>@(r.Seconds is null ? "-" : $"{r.Seconds} s")</td>
                        <td class="set-datafrom">
                            @if (r.SourceChangedUtc is DateTime changed) { <div class="set-sub">Salesforce changed @UkTime.Show(changed, "dd MMM HH:mm:ss")</div> }
                            @if (!string.IsNullOrEmpty(r.Error)) { <div class="set-error-cell" title="@r.Error">@r.Error</div> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed class StatusRow
    {
        public DateTime? LastCheckUtc { get; set; }
        public DateTime? LastCopyUtc { get; set; }
        public DateTime? SourceChangedUtc { get; set; }
        public int? SaleCount { get; set; }
        public bool Stale { get; set; }
    }

    private sealed class RunRow
    {
        public int LoadRunId { get; set; }
        public DateTime StartedUtc { get; set; }
        public DateTime? FinishedUtc { get; set; }
        public int? SaleCount { get; set; }
        public DateTime? SourceChangedUtc { get; set; }
        public bool? Succeeded { get; set; }
        public string? Error { get; set; }
        public int? Seconds { get; set; }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private StatusRow? _status;
    private List<RunRow>? _runs;
    private ShireCopySchedule? _schedule;
    private string? _error, _pauseReason;
    private bool _loading, _busy;

    private string EveryText => $"{_schedule?.EveryMinutes ?? ShireCopyControl.DefaultEvery} minutes";

    protected override async Task OnInitializedAsync()
    {
        Figures.Landed += OnChanged;    // a Shire copy landed
        Copy.Changed += OnCopyChanged;  // a check started / finished, the schedule changed
        _schedule = await Copy.GetAsync();
        await Load();
    }

    private void OnChanged() => _ = InvokeAsync(async () => { await Load(); StateHasChanged(); });

    private void OnCopyChanged() => _ = InvokeAsync(async () =>
    {
        _schedule = await Copy.GetAsync();
        if (!Copy.Running) await Load();
        StateHasChanged();
    });

    public void Dispose()
    {
        Figures.Landed -= OnChanged;
        Copy.Changed -= OnCopyChanged;
    }

    private async Task RefreshAll() { _schedule = await Copy.GetAsync(); await Load(); }

    private async Task Act(Func<KpiUser, Task> action)
    {
        _busy = true; _error = null;
        try
        {
            await action(await SettingsActor.GetAsync(AuthState, Scopes));
            _schedule = await Copy.GetAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task ChangeEvery(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var m) ? Act(actor => Copy.SetEveryAsync(actor, m)) : Task.CompletedTask;

    private Task Pause() => Act(async actor => { await Copy.PauseAsync(actor, _pauseReason); _pauseReason = null; });

    private Task Resume() => Act(actor => Copy.ResumeAsync(actor));

    private Task CopyNow() => Act(async actor =>
    {
        if (!await Copy.CopyNowAsync(actor)) _error = "A Copy now is already waiting to start.";
    });

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            using var cms = await Sessions.BeginAsync();
            _status = cms.Db.Report<StatusRow>("Shire.spDataStatus").SingleOrDefault();
            _runs = cms.Db.Report<RunRow>("Shire.spLoadHistory", new { Top = 50 });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
