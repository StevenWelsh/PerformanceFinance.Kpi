@page "/kpis/shire-business-analysis"
@layout EmptyLayout
@attribute [Authorize(Policy = "Dashboard.View")]
@inject KpiSessionFactory SessionFactory
@inject Kpi.Web.Data.Kpis.KpiScripts Scripts
@inject IJSRuntime JS
@inject Kpi.Web.Data.Kpis.KpiCache KpiCache
@inject Kpi.Web.Shire.ShireFiguresSignal Figures
@inject Kpi.Web.Colours.ColourTheme Colours
@implements IAsyncDisposable
@using Kpi.Web.Components.Shared.Kpis
@using Kpi.Web.Components.Shared.Kpis.Mobile
@using Kpi.Web.Components.Pages.Kpis.BusinessAnalysis
@using Kpi.Web.Shire

@* Shire Business Analysis (3 Nov 2026, Steve): PF's Business Analysis (Components/Pages/Kpis/BusinessAnalysis) over Shire's
   Salesforce - the same two layouts, switched by Dimension:
   • Profession / Facility / Purpose - the Full / YTD table, the year's donut (PF's BusinessAnalysis.razor.js) and the
     8-year trend as a small chart per category (BaTrendGrid);
   • Lender - four ranked year cards, each lender against itself the year before (to the same date for this year).
   Figures mirror Shire's own reports: Closed Won by Close Date (Shire.spBusinessAnalysis, Shire.spBusinessAnalysisByLender
   in Kpi.Data/Shire/002_ShireBusinessAnalysis.sql). Changed from PF's: the title says Shire; no Sales Office; no Arrangement
   or Division; Profession = the client's Sector, Facility = Finance Product in PF's groups (HP / Loan / Lease / Rental),
   Purpose = Loan Purpose, Lender = the Funder picklist; Measure = Amount Financed / Income (not AF / TFI); Proposed to PF
   (All / Yes / No). Unlike PF's, a value left blank in Salesforce shows as "Not set", so every dimension adds up to Shire
   Year on Year's totals; a Profession or Purpose with nothing in the chosen year or the year before is left out, and
   Facility always lists PF's four (HP, Loan, Lease, Rental) - Steve, 3 Nov 2026. In Shire's colours (kpi-shire). The phone view is PF's BusinessAnalysisMobile, given Shire's
   choices. *@

<PageTitle>@ShireReports.Title("Business Analysis") — KPIs</PageTitle>

<div class="kpi-shell kpi-shire">
    <KpiSidebar Active="shire-business-analysis" />

    <main class="kpi-main">
        <KpiPanel @ref="_panel" Title="@_panelTitle" Subtitle="@ShireReports.Source" AsAt="_asOf" RefreshedOn="_refreshedOn" IsShire="true"
                  RefreshRequested="OnRefreshRequested">
            <div class="kpi-filters kpi-ba-filters">
                <KpiField Caption="Dimension" Value="@_dimension" ValueChanged="OnDimension" Options="DimensionOptions" />
                <KpiField Caption="Measure" Value="@_measure" ValueChanged="OnMeasure" Options="ShireReports.MeasureOptions" />
                @* Lender view = four year cards, so Year does not apply there (a dash); Measure + Quarter apply to both. *@
                <KpiField Caption="Year" Value="@_year.ToString()" ValueChanged="OnYear" Options="YearOptions"
                          Text="@(_year > 0 ? null : "")" Enabled="!IsLender" />
                <KpiField Caption="Quarter" Value="@_quarter.ToString()" ValueChanged="OnQuarter" Options="QuarterOptions" />
                <KpiField Caption="Proposed to PF" Value="@_pf" ValueChanged="OnProposedToPF" Options="ShireReports.ProposedToPFOptions" />
            </div>

            @if (_loading)
            {
                <div class="ss-loading"><span class="ss-spinner"></span> Loading…</div>
            }
            else if (_error is not null)
            {
                <div class="ss-card-error"><i class="bi bi-exclamation-triangle-fill"></i> @_error</div>
            }
            else if (IsLender ? _lenderYears.Count == 0 : _rows.Count == 0)
            {
                <div class="ss-loading">No sales for these filters@(_anyCopy ? "" : " - nothing has been copied from Shire's Salesforce yet (Settings > Shire sync)").</div>
            }
            else if (IsLender)
            {
                @* ---- By Lender: four ranked year cards (latest 4 years), vs previous year ---- *@
                <div class="bal-grid">
                    @foreach (var yr in _lenderYears)
                    {
                        var card = LenderCard(yr);
                        <div class="ss-card bal-card">
                            <div class="ss-card-head">@MeasureText — @yr</div>
                            <table class="bal-table">
                                <thead>
                                    <tr>
                                        <th class="bal-rank"></th>
                                        <th class="bal-lender">Lender</th>
                                        <th class="bal-val">@MeasureShort</th>
                                        <th class="bal-vs">vs @(yr - 1)@(yr == ReportYear ? " YTD" : "")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var rank = 0; }
                                    @foreach (var row in card.Top)
                                    {
                                        rank++;
                                        <tr>
                                            <td class="bal-rank">@rank</td>
                                            <td class="bal-lender" title="@row.Lender">@row.Lender</td>
                                            <td class="bal-val">@Cur(row.Value)</td>
                                            <td class="bal-vs">@LenderDelta(row)</td>
                                        </tr>
                                    }
                                    @* pad to a fixed LenderRowSlots so every card is the same height *@
                                    @for (int i = card.Top.Count; i < LenderRowSlots; i++)
                                    {
                                        <tr class="bal-empty">
                                            <td class="bal-rank"></td>
                                            <td class="bal-lender">-</td>
                                            <td class="bal-val"></td>
                                            <td class="bal-vs"></td>
                                        </tr>
                                    }
                                    <tr class="bal-others">
                                        <td class="bal-rank"></td>
                                        <td class="bal-lender">Others</td>
                                        <td class="bal-val">@Cur(card.OthersValue)</td>
                                        <td class="bal-vs"></td>
                                    </tr>
                                    <tr class="bal-total">
                                        <td class="bal-rank"></td>
                                        <td class="bal-lender"></td>
                                        <td class="bal-val">@Cur(card.Total)</td>
                                        <td class="bal-vs"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ba-grid">
                    @* ---- Full/YTD comparison table ---- *@
                    <div class="ss-card ba-tablecard">
                        <div class="ss-card-head">@MeasureText — @_year</div>
                        <table class="ba-table">
                            <thead>
                                <tr>
                                    <th class="ba-dim">@_dimension</th>
                                    <th>Full @(_year - 1)</th>
                                    <th>YTD @(_year - 1)</th>
                                    <th>YTD @_year</th>
                                    <th>vs Previous YTD</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _dims)
                                {
                                    <tr data-dim="@d"
                                        @onmouseenter="() => HoverDim(d, true)"
                                        @onmouseleave="() => HoverDim(d, false)">
                                        <td class="ba-dim">@d</td>
                                        <td>@Cur(Full(_year - 1, d))</td>
                                        <td class="ba-muted">@Cur(Ytd(_year - 1, d))</td>
                                        <td>@Cur(Ytd(_year, d))</td>
                                        <td>@Delta(Ytd(_year - 1, d), Ytd(_year, d))</td>
                                    </tr>
                                }
                                <tr class="ba-total">
                                    <td class="ba-dim"></td>
                                    <td>@Cur(_dims.Sum(d => Full(_year - 1, d)))</td>
                                    <td class="ba-muted">@Cur(_dims.Sum(d => Ytd(_year - 1, d)))</td>
                                    <td>@Cur(_dims.Sum(d => Ytd(_year, d)))</td>
                                    <td>@Delta(_dims.Sum(d => Ytd(_year - 1, d)), _dims.Sum(d => Ytd(_year, d)))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    @* ---- the year's donut (PF's BusinessAnalysis.razor.js) ---- *@
                    <div class="ss-card ba-piecard">
                        <div class="ss-card-head">@MeasureText — @_year</div>
                        <div class="ba-pie-wrap">
                            <div class="ba-pie-host" @ref="_pieHost"></div>
                            <ul class="ba-legend">
                                @{ var pieTotal = PieSlices().Sum(s => s.Value); }
                                @foreach (var (label, value, colour) in PieSlices())
                                {
                                    var pct = pieTotal == 0 ? 0 : (int)Math.Round(100m * value / pieTotal);
                                    <li data-dim="@label"
                                        @onmouseenter="() => HoverDim(label, true)"
                                        @onmouseleave="() => HoverDim(label, false)">
                                        <span class="ba-swatch" style="background:@colour"></span>
                                        @label <span class="ba-legend-val">(@Cur(value)) [@pct%]</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* ---- 8-year trend: a small chart per category (BaTrendGrid, as PF's - 4 Nov 2026) ---- *@
                    <BaTrendGrid Title="@TrendTitle" Dims="_dims" Years="_trendYears" Year="_year"
                                 Full="Full" Ytd="Ytd" AsOf="_asOf" />
                </div>
            }
        </KpiPanel>
    </main>
</div>

<KpiMobile Title="Business Analysis" Subtitle="@ShireReports.PhoneSource" Active="shire-business-analysis" AsAt="_asOf" IsShire="true">
    <BusinessAnalysisMobile Loading="_loading" Error="@_error"
                            Dimension="@_dimension" Measure="@_measure" Year="_year" Quarter="_quarter"
                            Years="_allYears" Rows="_rows" Dims="_dims"
                            LenderRows="_lenderRows" LenderYears="_lenderYears" TopLenders="LenderRowSlots"
                            ReportDate="_asOf" ShowOffice="false"
                            DimensionChoices="DimensionOptions" MeasureChoices="ShireReports.MeasureOptions"
                            MeasureText="@MeasureText"
                            DimensionChanged="OnDimension" MeasureChanged="OnMeasure"
                            YearChanged="OnYear" QuarterChanged="OnQuarter">
        <MoreFilters>
            @* in the grid like the rest, beside Quarter - not a row of its own (Steve, 4 Nov 2026) *@
            <KpiField Caption="Proposed to PF" Value="@_pf" ValueChanged="OnProposedToPF" Options="ShireReports.ProposedToPFOptions" />
        </MoreFilters>
    </BusinessAnalysisMobile>
</KpiMobile>

@code {
    private string _dimension = "Profession";
    private string _measure = "AF";
    private int _year;
    private int _quarter;   // 0 = all
    private string _pf = "";   // "" = all, "1" = proposed to PF, "0" = not
    private DateTime? _asOf;
    private DateTime? _refreshedOn;
    private bool _loading = true;
    private bool _anyCopy = true;
    private string? _error;
    private KpiPanel? _panel;

    // The whole result the markup renders, for both layouts (only one is filled per key - _dimension is in it), as PF's.
    private sealed record Payload(
        List<BusinessAnalysisRow> Rows,
        List<string> Dims,
        List<int> TrendYears,
        List<int> AllYears,
        List<BusinessAnalysisLenderRow> LenderRows,
        List<int> LenderYears);

    private List<BusinessAnalysisRow> _rows = new();
    private List<string> _dims = new();
    private List<int> _trendYears = new();
    private List<int> _allYears = new();

    // ---- By Lender view ----
    private const int LenderRowSlots = 15;     // the top 15 lenders per card, padded; the rest are Others
    private const int LenderCardCount = 4;     // the latest four years, oldest left
    private bool IsLender => _dimension == ShireReports.LenderDimension;
    private string _panelTitle => ShireReports.Title(IsLender ? "Business Analysis — By Lender" : "Business Analysis");
    private List<BusinessAnalysisLenderRow> _lenderRows = new();
    private List<int> _lenderYears = new();

    private string MeasureText => ShireReports.MeasureLabel(_measure);
    private string TrendTitle => $"{MeasureText} — 8 year trend";
    private string MeasureShort => _measure == "Income" ? "Income" : "AF";

    private ElementReference _pieHost;
    private IJSObjectReference? _module;
    private bool _pieDirty;            // data changed -> redraw the JS donut and trend after the next render

    private static string Chart(int n) => $"var(--chart-{(n % 12) + 1})";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Load(firstLoad: true);
            return;
        }
        if (_pieDirty && ChartsShown) { _pieDirty = false; await DrawVisuals(); }
    }

    private bool ChartsShown => !_loading && _error is null && !IsLender && _rows.Count > 0;

    // PF's donut (BusinessAnalysis.razor.js), with colours as hex - it draws raw SVG.
    private async Task DrawVisuals()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", Scripts.Url("./Components/Pages/Kpis/BusinessAnalysis/BusinessAnalysis.razor.js"));

        await Colours.ReadyAsync();   // Settings > Colours (Mobberley): a chosen chart colour, else today's
        var slices = PieSlices();
        var total = slices.Sum(s => s.Value);
        var data = slices.Select((s, i) => new
        {
            label = s.Label,
            value = s.Value,
            colour = Colours.ChartHex(true, i) ?? ChartHex(i),
            pct = total == 0 ? 0 : (int)Math.Round(100m * s.Value / total),
            valueText = Cur(s.Value)
        });
        await _module.InvokeVoidAsync("render", _pieHost, data, Short(total));
    }

    // PF's chart colours, as hex for the JS
    private static readonly string[] _chartHex =
    {
        "#4F46E5", "#F59E0B", "#10B981", "#EF4444", "#8B5CF6", "#06B6D4",
        "#F97316", "#EC4899", "#84CC16", "#64748B"
    };
    private static string ChartHex(int n) => _chartHex[n % _chartHex.Length];

    private async Task HoverDim(string dim, bool on)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("hoverDim", _pieHost, dim, on);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }   // circuit already gone
        }
    }

    // the Shire copy's generation is part of the key: a copy makes every cached Shire figure obsolete (ShireFiguresSignal)
    private string CacheKey => KpiCache.Key("ShireBusinessAnalysis", Figures.Generation, _dimension, _measure, _year, _quarter, _pf);

    private async Task Load(bool firstLoad = false)
    {
        _loading = true;
        _error = null;
        StateHasChanged();
        await Task.Yield();
        try
        {
            // the Year filter opens on the report year, settled before the cache key (which holds it)
            if (firstLoad)
            {
                using var boot = await SessionFactory.BeginAsync();
                var reports = new ShireReports(boot.Db);
                _year = reports.ReportDate().Year;
                _anyCopy = reports.Salespeople().Count > 0;
            }
            var entry = await KpiCache.GetOrLoad(CacheKey, LoadPayload);
            Apply(entry.Data);
            _asOf = entry.AsAt;
            _refreshedOn = entry.LoadedAtUtc;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _loading = false;
            _pieDirty = !IsLender;
            StateHasChanged();
        }
    }

    // Pure loader (the cache may call it off the render path): the current dimension's query, as PF's.
    private async Task<(Payload, DateTime)> LoadPayload()
    {
        var (dimension, measure, year, quarter, pf) = (_dimension, _measure, _year, _quarter, ShireReports.ProposedToPF(_pf));
        using var cms = await SessionFactory.BeginAsync();
        var reports = new ShireReports(cms.Db);
        var asAt = reports.ReportDate();

        if (dimension == ShireReports.LenderDimension)
        {
            var lenderRows = reports.GetBusinessAnalysisByLender(measure, quarter, pf, asAt.Year);
            var lenderYears = lenderRows.Select(r => r.Yr).Distinct()
                                        .OrderByDescending(y => y).Take(LenderCardCount)
                                        .OrderBy(y => y).ToList();
            return (new Payload(new(), new(), new(), new(), lenderRows, lenderYears), asAt);
        }

        var rows = reports.GetBusinessAnalysis(dimension, measure, quarter, pf);
        var allYears = rows.Select(r => r.Yr).Distinct().OrderByDescending(y => y).ToList();
        // Which values show (Steve, 3 Nov 2026): a Profession or Purpose with nothing in the chosen year or the year
        // before is left out (so are its trend bars and phone row); Facility always shows PF's four, Rental too at £0.
        var values = rows.Select(r => r.DimValue).Distinct()
            .Where(d => dimension == "Facility"
                     || rows.Any(r => r.DimValue == d && (r.Yr == year || r.Yr == year - 1) && r.FullTotal != 0m))
            .Union(dimension == "Facility" ? FacilityGroups : Array.Empty<string>());
        // the table's order: the chosen year's biggest first, then all years'; Not set always last
        var dims = values
            .OrderBy(d => d == "Not set")
            .ThenByDescending(d => rows.Where(r => r.DimValue == d && r.Yr == year).Sum(r => r.FullTotal))
            .ThenByDescending(d => rows.Where(r => r.DimValue == d).Sum(r => r.FullTotal))
            .ToList();
        var trendYears = Enumerable.Range(year - 7, 8).ToList();
        return (new Payload(rows, dims, trendYears, allYears, new(), new()), asAt);
    }

    // the Year list keeps its first non-empty roster: the Lender payload carries none
    private void Apply(Payload p)
    {
        _rows = p.Rows;
        _dims = p.Dims;
        _trendYears = p.TrendYears;
        if (p.AllYears.Count > 0) _allYears = p.AllYears;
        _lenderRows = p.LenderRows;
        _lenderYears = p.LenderYears;
    }

    // KpiPanel calls this on its 10-min timer, return-to-view, and when a Shire copy lands
    private async Task OnRefreshRequested()
    {
        try
        {
            var (entry, changed) = await KpiCache.RefreshAsync(CacheKey, LoadPayload);
            _refreshedOn = entry.LoadedAtUtc;
            if (changed)
            {
                Apply(entry.Data);
                _pieDirty = !IsLender;
                StateHasChanged();
                if (_panel is not null) await _panel.FlashChanged();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // The filters - the full view's fields and the phone's call the same handlers.
    private async Task OnDimension(string v)    { _dimension = ShireReports.Dimensions.Contains(v) ? v : "Profession"; await Load(); }
    private async Task OnMeasure(string v)      { _measure = v == "Income" ? "Income" : "AF"; await Load(); }
    private async Task OnYear(string v)         { _year = int.TryParse(v, out var y) ? y : _year; await Load(); }
    private async Task OnQuarter(string v)      { _quarter = int.TryParse(v, out var q) ? q : 0; await Load(); }
    private async Task OnProposedToPF(string v) { _pf = v ?? ""; await Load(); }

    private static readonly KpiOption[] DimensionOptions = ShireReports.Dimensions.Select(d => new KpiOption(d, d)).ToArray();

    // PF's facilities (Steve): always listed under Facility, with or without Shire business (Shire.spBusinessAnalysis groups them)
    private static readonly string[] FacilityGroups = { "HP", "Loan", "Lease", "Rental" };
    private static readonly KpiOption[] QuarterOptions =
    {
        new("0", "All"), new("1", "Q1"), new("2", "Q2"), new("3", "Q3"), new("4", "Q4")
    };

    // The years with data, newest first - and the chosen year, which a quarter's data can lack.
    private List<KpiOption> YearOptions =>
        _allYears.Append(_year).Where(y => y > 0).Distinct().OrderByDescending(y => y)
                 .Select(y => new KpiOption(y.ToString(), y.ToString())).ToList();

    private decimal Full(int year, string dim) => _rows.FirstOrDefault(r => r.Yr == year && r.DimValue == dim)?.FullTotal ?? 0m;
    private decimal Ytd(int year, string dim)  => _rows.FirstOrDefault(r => r.Yr == year && r.DimValue == dim)?.YtdTotal ?? 0m;

    private List<(string Label, decimal Value, string Colour)> PieSlices()
        => _dims.Select((d, i) => (d, Full(_year, d), Chart(i)))
                .Where(s => s.Item2 > 0)
                .ToList();

    // ---- By Lender (as PF's) ----
    private (List<BusinessAnalysisLenderRow> Top, decimal OthersValue, decimal Total) LenderCard(int yr)
    {
        var rows = _lenderRows.Where(r => r.Yr == yr).OrderByDescending(r => r.Value).ToList();
        return (rows.Take(LenderRowSlots).ToList(), rows.Skip(LenderRowSlots).Sum(r => r.Value), rows.Sum(r => r.Value));
    }

    private int? ReportYear => _asOf?.Year;

    // a gold star for a lender new this year; a dash for one with business last year but none by this date; else the %
    private RenderFragment LenderDelta(BusinessAnalysisLenderRow row) => builder =>
    {
        if (row.PrevValue is null)
        {
            var title = $"New lender: no business with them in {row.Yr - 1}, so there's nothing to compare with.";
            builder.OpenElement(0, "i");
            builder.AddAttribute(1, "class", "bi bi-star-fill bal-star bal-new");
            builder.AddAttribute(2, "title", title);
            builder.AddAttribute(3, "aria-label", title);
            builder.CloseElement();
            return;
        }
        if (row.PrevValue == 0m)
        {
            var title = row.Yr == ReportYear
                ? $"Nothing to compare with yet: this lender's {row.Yr - 1} business all came after {_asOf:d MMMM}, so there was none by this date last year."
                : $"Nothing to compare with: no business with this lender in {row.Yr - 1}.";
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "ba-muted bal-dash");
            builder.AddAttribute(6, "title", title);
            builder.AddAttribute(7, "aria-label", title);
            builder.AddContent(8, "–");
            builder.CloseElement();
            return;
        }
        var prev = row.PrevValue.Value;
        var pct = (row.Value - prev) / Math.Abs(prev) * 100m;
        var up = pct >= 0;
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", up ? "ss-up" : "ss-down");
        builder.AddContent(9, (up ? "+" : "") + pct.ToString("N0") + "% " + (up ? "▲" : "▼"));
        builder.CloseElement();
    };

    private static string Cur(decimal v) => "£" + v.ToString("N0");
    private static string Short(decimal v)
        => v >= 1_000_000m ? "£" + (v / 1_000_000m).ToString("0.#") + "m"
         : v >= 1_000m     ? "£" + Math.Round(v / 1_000m) + "k"
         : "£" + v.ToString("N0");

    private RenderFragment Delta(decimal prev, decimal now) => builder =>
    {
        builder.OpenElement(0, "span");
        if (prev != 0m)
        {
            var pct = (now - prev) / Math.Abs(prev) * 100m;
            var up = pct >= 0;
            builder.AddAttribute(1, "class", up ? "ss-up" : "ss-down");
            builder.AddContent(2, (up ? "+" : "") + pct.ToString("N1") + "% " + (up ? "▲" : "▼"));
        }
        builder.CloseElement();
    };
}
