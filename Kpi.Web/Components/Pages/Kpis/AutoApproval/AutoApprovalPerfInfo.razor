@* The ⓘ on "Performance by rule" (Steve, 26 Nov 2026: a short, easy summary of how the table is worked out). Hover on a
   desktop, tap on a phone (account.css "fc-info", as Fund Capacity's). *@

<span class="fc-info aa-since @(Short ? "fc-info-short" : "")" tabindex="0" role="button" aria-label="How this table is worked out"
      @onclick="Toggle" @onclick:stopPropagation="true">
    i
    <span class="fc-tip aa-since-tip @(_open ? "fc-tip-on" : "")" role="tooltip">
        <span>Deals paid out since auto approval began (June 2023).</span>
        <span>The top 10 rules by amount financed; the rest under Other rules.</span>
        <span>Each deal counted once, at its worst: bad debt, terminated, or serious arrears (60+ days).</span>
        <span>Adverse rate = those deals ÷ deals paid out.</span>
        <span>Written off = the money lost. Not part of the rate.</span>
        <span>All non-auto approved: for comparison, not like for like.</span>
    </span>
</span>

@code {
    /// <summary>The phone's version, opened by a tap.</summary>
    [Parameter] public bool Short { get; set; }

    private bool _open;
    private void Toggle() { if (Short) _open = !_open; }
}
