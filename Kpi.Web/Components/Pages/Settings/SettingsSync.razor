@using Kpi.Web.Data
@using Kpi.Web.Account
@using Kpi.Data.Auth
@inject KpiSessionFactory Sessions
@inject KpiFiguresSignal Figures
@inject SyncAlerts Alerts
@inject UserAdmin Admin
@inject KpiCopyControl Copy
@inject IServiceScopeFactory Scopes
@implements IDisposable

@* Settings > Data sync: when the figures were last copied from CMS, whether a copy is overdue, and the recent copies
   with any errors (Ref.LoadRun, through Rpt.spDataStatus / Rpt.spLoadHistory). The site's own copy (KpiPull) collects
   KPI_Export's copies from the office after each refresh there; a failure is logged here once when it starts and then
   hourly (Settings > Integrations > SQL data source shows the latest problem). Each copy's two parts are shown as
   ticks (Steve, 19 Oct 2026): Day's figures in every copy, Bad Debt & Exposure only in a "Nightly" one. "Data from" is
   when the office made the data that copy carried - the day's figures, and on a Nightly copy Bad Debt & Exposure too -
   so a fresh refresh can be seen being picked up; a copy that
   couldn't go ahead (another copy holding the lock) is a cross with its reason, and one cut off part-way (a restart)
   is closed as failed rather than shown running for ever (migration LoadRunDetail). *@

<div class="set-head">
    <div>
        <h2>Data sync</h2>
        <p class="acc-hint">The office refreshes the figures every 10 minutes (7am-8pm, Monday to Saturday) and the site collects each refresh within @EveryText; Bad Debt and Exposure are prepared once a night.</p>
    </div>
    <button type="button" class="acc-btn-secondary" disabled="@_loading" @onclick="RefreshAll"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>

@if (_error is not null)
{
    <div class="login-error" role="alert"><i class="bi bi-exclamation-triangle-fill"></i> @_error</div>
}
@if (_status is not null)
{
    <div class="set-tiles">
        <div class="set-tile @(_status.FiguresStale ? "set-tile-bad" : "")">
            <span class="set-tile-label">Last copy</span>
            <span class="set-tile-value">@UkTime.Show(_status.LastFrequentLoadUtc)</span>
            <span class="set-tile-note">@(_status.FiguresStale ? "Overdue: more than 45 minutes ago, in office hours" : "Every 10 minutes in office hours")</span>
        </div>
        <div class="set-tile @(_status.NightlyStale ? "set-tile-bad" : "")">
            <span class="set-tile-label">Last Bad Debt &amp; Exposure</span>
            <span class="set-tile-value">@UkTime.Show(_status.LastNightlyLoadUtc)</span>
            <span class="set-tile-note">@(_status.NightlyStale ? "Overdue: more than 26 hours ago" : "Bad Debt and Exposure")</span>
        </div>
        <div class="set-tile">
            <span class="set-tile-label">Figures as at</span>
            @* as every report's "As at": the date, and the last copy's time when it is that day (Steve, 19 Oct 2026) *@
            <span class="set-tile-value">@Kpi.Web.Data.Kpis.KpiDataStatus.AsAtText(_status.ReportDate, new(_status.LastFrequentLoadUtc, _status.FiguresStale))</span>
            <span class="set-tile-note">@FailedToday</span>
        </div>
    </div>
}

@* Copying (29 Oct 2026, Steve, after a day of failing copies): how often the site checks the office, pause / resume, and
   Copy now - which copies even unchanged data, and works while paused (KpiCopyControl) *@
@if (_schedule is not null)
{
    <div class="set-alerts set-copy">
        <div class="set-alerts-head">
            <h3>Copying</h3>
            @if (Copy.Running)
            {
                <span class="set-running"><span class="set-pulse" aria-hidden="true"></span>Copying now (since @UkTime.Show(Copy.RunningSinceUtc, "HH:mm:ss"))</span>
            }
            else if (_schedule.Paused)
            {
                <span class="set-pill set-pill-switchedoff"><i class="bi bi-pause-fill"></i> Paused</span>
            }
            else
            {
                <span class="set-pill set-pill-active"><i class="bi bi-play-fill"></i> On</span>
            }
        </div>
        @if (_schedule.Paused)
        {
            <p class="set-sub">Paused by @_schedule.PausedBy at @UkTime.Show(_schedule.PausedUtc, "HH:mm 'on' dd MMM")@(_schedule.PausedReason is null ? "" : $": {_schedule.PausedReason}").
               The reports keep the figures they have until it's resumed. Copy now still works.</p>
        }
        else if (!Copy.Running && Copy.NextCheckUtc is { } next)
        {
            <p class="set-sub">Next check at @UkTime.Show(next, "HH:mm:ss"): a copy only when the office has refreshed since the last one.</p>
        }
        <div class="set-copy-row">
            <label class="set-copy-every">Check every
                <select value="@_schedule.EveryMinutes" @onchange="ChangeEvery" disabled="@_busy">
                    @foreach (var m in KpiCopyControl.EveryChoices) { <option value="@m">@m minutes</option> }
                </select>
            </label>
            <button type="button" class="acc-btn" disabled="@(_busy || Copy.PendingBy is not null)" @onclick="CopyNow"
                    title="Copy now, even if the office has nothing newer - to check the copy works">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Copy now
            </button>
            @if (_schedule.Paused)
            {
                <button type="button" class="acc-btn-secondary" disabled="@_busy" @onclick="Resume"><i class="bi bi-play-fill" aria-hidden="true"></i> Resume</button>
            }
            else
            {
                <input class="set-copy-reason" @bind="_pauseReason" placeholder="Reason (optional)" maxlength="200" aria-label="Reason for pausing" />
                <button type="button" class="acc-btn-secondary" disabled="@_busy" @onclick="Pause"><i class="bi bi-pause-fill" aria-hidden="true"></i> Pause</button>
            }
        </div>
        @if (Copy.PendingBy is not null)
        {
            <p class="set-sub">Copy now asked for by @Copy.PendingBy: it starts @(Copy.Running ? "when the copy running now finishes" : "in a moment").</p>
        }
        else if (Copy.LastManual is { } m)
        {
            <p class="@(m.Ok == false ? "set-copy-bad" : "set-sub")">
                Copy now by @m.By at @UkTime.Show(m.RequestedUtc, "HH:mm:ss"):
                @(m.Result ?? "copying…")
            </p>
        }
    </div>
}

@* Alerts (19 Oct 2026, Steve): who is emailed when the figures stop arriving, and what is wrong now (SyncAlerts) *@
<div class="set-alerts">
    <div class="set-alerts-head">
        <h3>Alerts</h3>
        @if (_problems is { Count: > 0 })
        {
            <span class="set-pill set-pill-needsattention"><i class="bi bi-exclamation-triangle-fill"></i> Problem</span>
        }
        else if (_problems is not null)
        {
            <span class="set-pill set-pill-active"><i class="bi bi-check-lg"></i> All clear</span>
        }
    </div>
    <p class="acc-hint">Emailed when the copy keeps failing (10 minutes or more), can't run, no new figures arrive for 45 minutes in
       office hours, or Bad Debt &amp; Exposure miss their nightly run - once when it starts, every 4 hours in office hours while it
       lasts, and once when it's over.</p>
    @if (_problems is { Count: > 0 })
    {
        <ul class="set-alerts-problems">
            @foreach (var p in _problems) { <li>@p</li> }
        </ul>
        @if (_alertSettings?.Open is { } open)
        {
            <p class="set-sub">Alerted since @UkTime.Show(open.SinceUtc, "HH:mm 'on' dd MMM"); last email @UkTime.Show(open.LastSentUtc, "HH:mm 'on' dd MMM").</p>
        }
        else
        {
            <p class="set-sub">Not emailed yet: a copy failure is emailed once it has lasted 10 minutes.</p>
        }
    }
    @if (_people is not null)
    {
        <div class="set-reports set-alerts-people">
            @if (_people.Count == 0) { <span class="set-sub">Nobody has an active account yet.</span> }
            @foreach (var u in _people)
            {
                <label class="acc-check">
                    <input type="checkbox" checked="@_recipients.Contains(u.Id)" @onchange="e => TickRecipient(u.Id, e)" />
                    @u.Name <span class="set-sub">@u.Email</span>
                    @if (_alertSettings is not null && _alertSettings.LastSentUtc.TryGetValue(u.Id, out var sent))
                    {
                        <span class="set-sub"> · last alert @UkTime.Show(sent, "dd MMM HH:mm")</span>
                    }
                </label>
            }
        </div>
        <button type="button" class="acc-btn" disabled="@(!_recipientsDirty || _savingRecipients)" @onclick="SaveRecipients">Save who gets alerts</button>
        @if (_recipientsSaved) { <span class="set-sub set-saved"> Saved.</span> }
    }
</div>

@if (_runs is not null)
{
    <div class="set-table-wrap">
        <table class="set-table">
            <thead>
                <tr>
                    <th>Started</th>
                    <th class="set-part">Day's figures <i class="bi bi-info-circle set-info" tabindex="0" title="@DayHelp" aria-label="@DayHelp"></i></th>
                    <th class="set-part">Bad Debt &amp; Exposure <i class="bi bi-info-circle set-info" tabindex="0" title="@NightHelp" aria-label="@NightHelp"></i></th>
                    <th>Took</th>
                    <th>Info <i class="bi bi-info-circle set-info" tabindex="0" title="@DataFromHelp" aria-label="@DataFromHelp"></i></th>
                </tr>
            </thead>
            <tbody>
                @if (_runs.Count == 0)
                {
                    <tr><td colspan="5" class="set-sub">No copies yet.</td></tr>
                }
                @for (var i = 0; i < _runs.Count; i++)
                {
                    var r = _runs[i];
                    // the copy before this one that carried a data time (the list is newest first)
                    var before = _runs.Skip(i + 1).FirstOrDefault(x => x.SourceRefreshedUtc is not null);
                    <tr>
                        <td>@UkTime.Show(r.StartedUtc, "dd MMM HH:mm:ss")</td>
                        <td class="set-part">@Part(r, included: true)</td>
                        <td class="set-part">@Part(r, included: r.Scope == "Nightly")</td>
                        <td>@(r.Seconds is null ? "-" : $"{r.Seconds} s")</td>
                        <td class="set-datafrom">
                            @DataFrom(r, before)
                            @if (!string.IsNullOrEmpty(r.Error)) { <div class="set-error-cell" title="@r.Error">@r.Error</div> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed class StatusRow
    {
        public DateTime ReportDate { get; set; }
        public DateTime? LastFrequentLoadUtc { get; set; }
        public DateTime? LastNightlyLoadUtc { get; set; }
        public bool FiguresStale { get; set; }
        public bool NightlyStale { get; set; }
    }

    private sealed class RunRow
    {
        public int LoadRunId { get; set; }
        public string Scope { get; set; } = "";
        public DateTime StartedUtc { get; set; }
        public DateTime? FinishedUtc { get; set; }
        public DateTime? SourceRefreshedUtc { get; set; }
        public DateTime? SourceSnapshotsUtc { get; set; }
        public bool? Succeeded { get; set; }
        public string? Error { get; set; }
        public int? Seconds { get; set; }
    }

    private const string DayHelp = "Day's figures: every table the reports use except Bad Debt and Exposure - leads, salespeople, targets, "
        + "funds, book position and the rest. In every copy: the office refreshes them every 10 minutes (7am-8pm, Monday to Saturday).";
    private const string DataFromHelp = "What this copy carried, and any error: \"New data from\" the time the office made it (its refresh of KPI_Export, "
        + "every 10 minutes), or \"Same data as before\" when it was the same refresh as the copy before - and, on a nightly copy, when "
        + "Bad Debt & Exposure were prepared (about 00:15).";

    // "Data" (Steve, 19 Oct 2026): one comment saying what this copy carried - NEW data (the office's time for it, newer
    // than the copy before) or the SAME data as before - with Bad Debt & Exposure's preparation time on a nightly copy
    private static RenderFragment DataFrom(RunRow r, RunRow? before) => __builder =>
    {
        if (r.SourceRefreshedUtc is not DateTime day) { if (string.IsNullOrEmpty(r.Error)) { <span class="set-sub">-</span> } return; }
        var time = UkTime.Show(day, UkTime.FromUtc(day).Date == UkTime.FromUtc(r.StartedUtc).Date ? "HH:mm:ss" : "dd MMM HH:mm:ss");
        var same = before?.SourceRefreshedUtc == day;
        var copied = r.Succeeded == true ? ", copied" : r.Succeeded == false ? ", not copied" : "";
        if (same) { <div class="set-sub">Same data as before (@time)@copied</div> }
        else { <div>New data from @time@copied</div> }
        if (r.SourceSnapshotsUtc is DateTime night)
        {
            <div class="set-sub">Bad Debt &amp; Exposure prepared @UkTime.Show(night, "dd MMM HH:mm:ss")</div>
        }
    };
    private const string NightHelp = "Bad Debt & Exposure: last night's results of the desktop's own Bad Debt and Exposure reports, prepared in "
        + "the office at 00:15. Included in the first copy after they are prepared - so about once a night (a \"Nightly\" copy, which also "
        + "brings the day's figures).";

    // a tick when the part was copied, a cross when the copy failed, a dash when this copy doesn't include that part
    private static RenderFragment Part(RunRow r, bool included) => __builder =>
    {
        if (!included) { <span class="set-part-none" title="Not part of this copy">–</span> }
        else if (r.Succeeded == true) { <i class="bi bi-check-lg set-part-ok" title="Copied" aria-label="Copied"></i> }
        else if (r.Succeeded == false) { <i class="bi bi-x-lg set-part-bad" title="Failed - see Info" aria-label="Failed"></i> }
        else { <span class="set-running" title="Copying now"><span class="set-pulse" aria-hidden="true"></span>Running</span> }
    };

    private StatusRow? _status;
    private List<RunRow>? _runs;
    private string? _error;
    private bool _loading;

    private string FailedToday
    {
        get
        {
            var since = DateTime.UtcNow.AddHours(-24);
            var failed = _runs?.Count(r => r.Succeeded == false && r.StartedUtc > since) ?? 0;
            return failed == 0 ? "No failed copies in the last 24 hours" : $"{failed} failed cop{(failed == 1 ? "y" : "ies")} in the last 24 hours";
        }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<UserAdmin.UserRow>? _people;
    private HashSet<string> _recipients = new();
    private SyncAlertSettings? _alertSettings;
    private List<string>? _problems;
    private bool _recipientsDirty, _savingRecipients, _recipientsSaved;

    private CopyScheduleSettings? _schedule;
    private string? _pauseReason;
    private bool _busy;

    private string EveryText => _schedule is null || _schedule.EveryMinutes == 2 ? "two minutes" : $"{_schedule.EveryMinutes} minutes";

    protected override async Task OnInitializedAsync()
    {
        Figures.Landed += OnChanged;    // a new copy landed: show it without pressing Refresh
        Alerts.Changed += OnChanged;    // an alert opened or closed
        Copy.Changed += OnCopyChanged;  // a copy started / finished, the schedule changed
        _schedule = await Copy.GetAsync();
        await Load();
        await LoadAlerts(resetTicks: true);
    }

    private void OnChanged() => _ = InvokeAsync(async () => { await Load(); await LoadAlerts(resetTicks: false); StateHasChanged(); });

    // the copy's own state is in memory: just redraw, and re-read the schedule (pause / interval) - and the list when a copy ends
    private void OnCopyChanged() => _ = InvokeAsync(async () =>
    {
        _schedule = await Copy.GetAsync();
        if (!Copy.Running) await Load();
        StateHasChanged();
    });

    public void Dispose()
    {
        Figures.Landed -= OnChanged;
        Alerts.Changed -= OnChanged;
        Copy.Changed -= OnCopyChanged;
    }

    private async Task RefreshAll() { _schedule = await Copy.GetAsync(); await Load(); await LoadAlerts(resetTicks: false); }

    private async Task Act(Func<KpiUser, Task> action)
    {
        _busy = true; _error = null;
        try
        {
            await action(await SettingsActor.GetAsync(AuthState, Scopes));
            _schedule = await Copy.GetAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task ChangeEvery(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var m) ? Act(actor => Copy.SetEveryAsync(actor, m)) : Task.CompletedTask;

    private Task Pause() => Act(async actor => { await Copy.PauseAsync(actor, _pauseReason); _pauseReason = null; });

    private Task Resume() => Act(actor => Copy.ResumeAsync(actor));

    private Task CopyNow() => Act(async actor =>
    {
        if (!await Copy.CopyNowAsync(actor)) _error = "A Copy now is already waiting to start.";
    });

    private async Task LoadAlerts(bool resetTicks)
    {
        try
        {
            _alertSettings = await Alerts.GetAsync();
            _problems = await Alerts.ProblemsAsync();
            if (AuthState is not null)
                _people = (await Admin.ListAsync((await AuthState).User)).Where(u => u.Status == "Active").ToList();
            if (resetTicks) { _recipients = _alertSettings.RecipientIds.ToHashSet(); _recipientsDirty = false; }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void TickRecipient(string id, ChangeEventArgs e)
    {
        if (e.Value is true) _recipients.Add(id); else _recipients.Remove(id);
        _recipientsDirty = true; _recipientsSaved = false;
    }

    private async Task SaveRecipients()
    {
        _savingRecipients = true;
        try
        {
            var names = _people!.Where(u => _recipients.Contains(u.Id)).Select(u => u.Name).ToList();
            await Alerts.SaveRecipientsAsync(await SettingsActor.GetAsync(AuthState, Scopes), _recipients.ToList(), names);
            _recipientsDirty = false; _recipientsSaved = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _savingRecipients = false; }
    }

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            using var cms = await Sessions.BeginAsync();
            _status = cms.Db.Report<StatusRow>("Rpt.spDataStatus").SingleOrDefault();
            _runs = cms.Db.Report<RunRow>("Rpt.spLoadHistory", new { Top = 50 });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
