@using System.Security.Claims
@using Kpi.Data.Cfg
@using Kpi.Web.Integrations
@inject IntegrationStore Store
@inject Mailer Mail
@inject IServiceScopeFactory Scopes

@* The Resend card (Settings > Integrations), DavidsonHR's look: the wordmark, a plug for the state, one sentence, one
   button - Connect, or Connected / Needs attention opening the details. The API key is encrypted on the server and never
   shown back: a blank box keeps the saved one. The test address catches every email while testing; outside the live
   site nothing is sent without one. *@

<div class="intg-card">
    <div class="intg-head">
        <span class="intg-name"><img class="intg-logo" src="img/resend-wordmark.svg" alt="Resend" /></span>
        <IntegrationPlug Row="_row" />
    </div>
    <p class="intg-desc">Emails invitations, mobile resets and password links.</p>
    <IntegrationButton Row="_row" ConnectText="Connect Resend" OnClick="Open" />
</div>

@if (_open && _row is not null)
{
    <div class="set-backdrop" @onclick="() => _open = false"></div>
    <div class="set-dialog" role="dialog" aria-modal="true" aria-labelledby="resend-title">
        <h3 id="resend-title">Resend</h3>
        @if (_message is not null)
        {
            <div class="@(_messageOk ? "login-notice" : "login-error")" role="status">
                <i class="bi @(_messageOk ? "bi-check-circle" : "bi-exclamation-triangle-fill")"></i> @_message
            </div>
        }

        @if (!_editing)
        {
            <dl class="acc-facts">
                <dt>From</dt><dd>@(_settings is null ? "-" : $"{_settings.FromName} <{_settings.FromAddress}>")</dd>
                <dt>API key</dt><dd>@(_settings?.KeyHint ?? "-")</dd>
                <dt>Test address</dt><dd>@(_row.RedirectTo ?? "None - emails go to the real people")</dd>
                <dt>Last worked</dt><dd>@Kpi.Web.Data.UkTime.Show(_row.LastOkUtc)</dd>
                @if (_row.LastErrorUtc is not null && (_row.LastOkUtc is null || _row.LastErrorUtc > _row.LastOkUtc))
                {
                    <dt>Last problem</dt><dd class="set-bad">@Kpi.Web.Data.UkTime.Show(_row.LastErrorUtc): @_row.LastError</dd>
                }
            </dl>
            <div class="set-buttons">
                <button type="button" class="acc-btn" @onclick="StartEdit">Change</button>
                <button type="button" class="acc-btn-secondary" disabled="@_busy" @onclick="SendTest">Send me a test email</button>
                <button type="button" class="acc-btn-secondary set-act-danger" @onclick="() => _confirmDisconnect = true">Disconnect</button>
            </div>
            @if (_confirmDisconnect)
            {
                <div class="set-confirm">
                    <p>Disconnect Resend? The saved key is deleted and no email is sent until it is connected again.</p>
                    <button type="button" class="acc-btn-secondary" @onclick="() => _confirmDisconnect = false">Cancel</button>
                    <button type="button" class="acc-btn" @onclick="Disconnect">Disconnect</button>
                </div>
            }
        }
        else
        {
            <p class="acc-hint">Get an API key at resend.com, with the sending domain verified there.</p>
            <label class="login-label" for="r-from">From address</label>
            <input id="r-from" type="email" @bind="_fromAddress" placeholder="kpi@performancefinance.co.uk" />
            <label class="login-label" for="r-name">From name</label>
            <input id="r-name" @bind="_fromName" placeholder="Performance Finance KPIs" />
            <label class="login-label" for="r-key">API key</label>
            <input id="r-key" type="password" @bind="_apiKey" autocomplete="new-password" data-lpignore="true" data-1p-ignore
                   placeholder="@(_settings is null ? "re_..." : "Leave blank to keep the saved key")" />
            <label class="login-label" for="r-test">Test address</label>
            <input id="r-test" type="email" @bind="_redirectTo" placeholder="While testing, every email goes here instead" />
            <label class="acc-check"><input type="checkbox" @bind="_enabled" /> Send emails</label>
        }

        <div class="set-dialog-buttons">
            @if (_editing)
            {
                <button type="button" class="acc-btn-secondary" @onclick="CancelEdit">Cancel</button>
                <button type="button" class="acc-btn-secondary" disabled="@_busy" @onclick="CheckKey">Check the key</button>
                <button type="button" class="acc-btn" disabled="@_busy" @onclick="Save">@(_busy ? "Saving…" : "Save")</button>
            }
            else
            {
                <button type="button" class="acc-btn-secondary" @onclick="() => _open = false">Close</button>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Integration? _row;
    private ResendSettings? _settings;
    private bool _open, _editing, _busy, _confirmDisconnect, _messageOk;
    private string? _message;
    private string _fromAddress = "", _fromName = "Performance Finance KPIs", _apiKey = "", _redirectTo = "";
    private bool _enabled = true;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _row = await Store.GetAsync(IntegrationProviders.Resend);
        _settings = IntegrationStore.ReadSettings<ResendSettings>(_row);
    }

    // not connected: straight to the form; connected: the details first
    private void Open()
    {
        _message = null; _confirmDisconnect = false;
        if (_row?.Status == IntegrationStatus.NotConnected) StartEdit(); else _editing = false;
        _open = true;
    }

    private void StartEdit()
    {
        _fromAddress = _settings?.FromAddress ?? "";
        _fromName = _settings?.FromName ?? "Performance Finance KPIs";
        _redirectTo = _row?.RedirectTo ?? "";
        _enabled = _row?.Enabled ?? true;
        _apiKey = "";
        _message = null;
        _editing = true;
    }

    private void CancelEdit()
    {
        if (_row?.Status == IntegrationStatus.NotConnected) _open = false;
        _editing = false; _message = null;
    }

    private async Task Save()
    {
        _busy = true; _message = null;
        try
        {
            if (!_fromAddress.Contains('@')) throw new InvalidOperationException("Enter the address emails come from.");
            await Store.SaveResendAsync(await SettingsActor.GetAsync(AuthState, Scopes), _fromAddress, _fromName, _apiKey, _redirectTo, _enabled);
            _editing = false;
            Say(true, "Saved.");
            await Load();
        }
        catch (InvalidOperationException ex) { Say(false, ex.Message); }
        finally { _busy = false; }
    }

    // the typed key, or the saved one when the box is blank
    private async Task CheckKey()
    {
        _busy = true; _message = null;
        try
        {
            var key = _apiKey.Trim();
            if (key.Length == 0 && _row is not null) key = Store.ReadSecrets<ResendSecrets>(_row)?.ApiKey ?? "";
            if (key.Length == 0) { Say(false, "Enter the API key."); return; }
            var problem = await Mail.VerifyKeyAsync(key);
            Say(problem is null, problem ?? "Resend accepted the key.");
        }
        catch (Exception ex) when (ex is HttpRequestException or IntegrationSecretsUnreadableException) { Say(false, ex.Message); }
        finally { _busy = false; }
    }

    private async Task SendTest()
    {
        _busy = true; _message = null;
        try
        {
            var me = (await AuthState!).User.FindFirstValue(ClaimTypes.Email) ?? "";
            var outcome = await Mail.TestAsync(me);
            Say(outcome == MailOutcome.Sent, outcome switch
            {
                MailOutcome.Sent => _row?.RedirectTo is { } r ? $"Sent - to the test address, {r}." : $"Sent to {me}.",
                MailOutcome.NotConfigured => "Not sent: Resend is switched off.",
                MailOutcome.NoTestAddress => "Not sent: this isn't the live site, so emails only go to a test address. Set one under Change.",
                _ => "Not sent: see Last problem."
            });
            await Load();
        }
        finally { _busy = false; }
    }

    private async Task Disconnect()
    {
        await Store.DisconnectAsync(IntegrationProviders.Resend, await SettingsActor.GetAsync(AuthState, Scopes));
        _confirmDisconnect = false;
        _open = false;
        await Load();
    }

    private void Say(bool ok, string message) { _messageOk = ok; _message = message; }
}
