@using Kpi.Data.Cfg
@using Kpi.Web.Data
@using Kpi.Web.Data.Kpis
@using Kpi.Web.Views
@implements IAsyncDisposable
@inject PublishedLinkStore Links
@inject IServiceScopeFactory Scopes
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject KpiScripts Scripts

@* Settings > Published links (Oct 2026, Steve): one report opened by URL without signing in - for CMS's KPI tabs,
   replacing Klipfolio's published dashboards. Every active link's URL can be copied or opened here at any time (its key
   is kept encrypted - Steve: not sensitive, and locked to the allowed addresses). The allowed addresses limit where links open from: CMS runs
   over the VPN, but a VPN that sends only office traffic through the office leaves people at home on their own
   address - so empty (any address) is a real choice, with the key the only protection. *@

<div class="set-head">
    <div>
        <h2>Published links</h2>
        <p class="acc-hint">One report, opened by its link without signing in - for CMS's KPI tabs. It shows that report
           only: no menus, no other reports, and always the full layout.</p>
    </div>
</div>

@if (_message is not null)
{
    <div class="@(_messageOk ? "login-notice" : "login-error")" role="status">
        <i class="bi @(_messageOk ? "bi-check-circle" : "bi-exclamation-triangle-fill")"></i> @_message
    </div>
}

<div class="set-card pl-card">
    <div class="set-card-head">
        <div>
            <h3><i class="bi bi-shield-lock" aria-hidden="true"></i> Allowed addresses</h3>
            <p class="acc-hint">Links open only from these public IP addresses (one per line).
               <b>Empty = any address</b> - then the link alone is the protection, as with Klipfolio.</p>
        </div>
    </div>
    <textarea class="pl-addresses" rows="3" @bind="_addressesText" spellcheck="false" placeholder="Any address"></textarea>
    <div class="set-buttons">
        <button type="button" class="acc-btn" disabled="@_busy" @onclick="SaveAddresses">Save addresses</button>
        @if (!string.IsNullOrEmpty(_myAddress))
        {
            <span class="acc-hint">You're reaching the site from <b>@_myAddress</b>.</span>
            @if (!_addressesText.Contains(_myAddress))
            {
                <button type="button" class="acc-btn-secondary" @onclick="AddMine">Add it</button>
            }
        }
    </div>
    @if (_savedAddresses.Count == 0)
    {
        <p class="acc-hint pl-warn"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Links currently open from any address.</p>
    }
</div>

<div class="set-card pl-card">
    <div class="set-card-head">
        <div><h3><i class="bi bi-link-45deg" aria-hidden="true"></i> New link</h3></div>
    </div>
    <div class="pl-new">
        <div>
            <label class="login-label" for="pl-label">Label</label>
            <input id="pl-label" @bind="_label" placeholder="CMS desktop: Business Analysis tab" maxlength="200" />
        </div>
        <div>
            <label class="login-label" for="pl-report">Report</label>
            <select id="pl-report" @bind="_slug">
                <option value="">Choose…</option>
                @foreach (var r in Publishable)
                {
                    <option value="@r.Slug">@r.Label</option>
                }
            </select>
        </div>
        <button type="button" class="acc-btn" disabled="@_busy" @onclick="Create">Make link</button>
    </div>
    <label class="acc-check"><input type="checkbox" @bind="_newShowHeader" /> Show the header (the report's title and its "As at / Refreshed" lines)</label>
    @if (_newUrl is not null)
    {
        <div class="pl-made" role="status">
            <p><b>Link made.</b> Paste it into CMS's Dashboards table for that tab. You can copy it again from the list below at any time.</p>
            <div class="pl-url">
                <input readonly value="@_newUrl" aria-label="The new link" />
                <button type="button" class="acc-btn" @onclick="() => Copy(_newUrl, -1)">@(_copiedId == -1 ? "Copied" : "Copy")</button>
                <a class="acc-btn-secondary" href="@_newUrl" target="_blank" rel="noreferrer">Open</a>
                <button type="button" class="acc-btn-secondary" @onclick="() => _newUrl = null">Done</button>
            </div>
        </div>
    }
</div>

@if (_rows is null)
{
    <div class="ss-loading"><span class="ss-spinner"></span> Loading…</div>
}
else if (_rows.Count == 0)
{
    <p class="acc-hint">No links yet.</p>
}
else
{
    <div class="set-table-wrap">
        <table class="set-table">
            <thead><tr><th>Label</th><th>Report</th><th>Header</th><th>Made</th><th>Last opened</th><th>Opens</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    var l = row.Link;
                    <tr class="@(l.RevokedUtc is null ? "" : "pl-revoked")">
                        <td>@l.Label</td>
                        <td>@ReportLabel(l.ReportSlug)</td>
                        <td>
                            @if (l.RevokedUtc is null)
                            {
                                <label class="acc-check pl-header" title="The report's title and its As at / Refreshed lines. An open tab follows within a minute.">
                                    <input type="checkbox" checked="@l.ShowHeader" @onchange="e => SetHeader(l.Id, e.Value is true)" /> Show
                                </label>
                            }
                            else { <span class="set-sub">@(l.ShowHeader ? "Shown" : "Hidden")</span> }
                        </td>
                        <td class="set-nowrap">@UkTime.Show(l.CreatedUtc, "dd MMM yyyy")<div class="set-sub">@row.CreatedBy</div></td>
                        <td class="set-nowrap">@(l.LastUsedUtc is null ? "Never" : UkTime.Show(l.LastUsedUtc, "dd MMM HH:mm"))<div class="set-sub">@l.LastUsedAddress</div></td>
                        <td>@l.UseCount</td>
                        <td class="set-nowrap">
                            @if (l.RevokedUtc is not null)
                            {
                                <span class="set-sub">Revoked @UkTime.Show(l.RevokedUtc, "dd MMM yyyy")@(row.RevokedBy is null ? "" : $" by {row.RevokedBy}")</span>
                            }
                            else if (_confirmRevoke == l.Id)
                            {
                                <span class="set-sub">Revoke? An open tab stops within a minute.</span>
                                <button type="button" class="acc-btn-secondary" @onclick="() => _confirmRevoke = null">Cancel</button>
                                <button type="button" class="acc-btn set-act-danger" @onclick="() => Revoke(l.Id)">Revoke</button>
                            }
                            else
                            {
                                var url = UrlOf(l);
                                if (url is null)
                                {
                                    <span class="set-sub" title="The site's key ring changed since it was made: revoke it and make another">Link can't be shown</span>
                                }
                                else
                                {
                                    <button type="button" class="acc-btn-secondary" @onclick="() => Copy(url, l.Id)">@(_copiedId == l.Id ? "Copied" : "Copy link")</button>
                                    <a class="acc-btn-secondary" href="@url" target="_blank" rel="noreferrer">Open</a>
                                }
                                <button type="button" class="acc-btn-secondary set-act-danger" @onclick="() => _confirmRevoke = l.Id">Revoke</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<PublishedLinkRow>? _rows;
    private List<string> _savedAddresses = [];
    private string _addressesText = "";
    private string? _myAddress;
    private string _label = "", _slug = "";
    private string? _newUrl, _message;
    private bool _busy, _messageOk, _newShowHeader = true;
    private int? _copiedId;
    private int? _confirmRevoke;
    private IJSObjectReference? _module;

    private static IEnumerable<KpiReport> Publishable => KpiReports.All.Where(r => PublishedReports.PageFor(r.Slug) is not null);
    private static string ReportLabel(string slug) => KpiReports.All.FirstOrDefault(r => r.Slug == slug)?.Label ?? slug;

    protected override async Task OnInitializedAsync()
    {
        _savedAddresses = (await Links.AllowedAddressesAsync()).ToList();
        _addressesText = string.Join("\n", _savedAddresses);
        _rows = await Links.ListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", Scripts.Url("./js/publishedLinks.js"));
        _myAddress = await _module.InvokeAsync<string>("myAddress");
        StateHasChanged();
    }

    private void AddMine() =>
        _addressesText = string.IsNullOrWhiteSpace(_addressesText) ? _myAddress! : _addressesText.TrimEnd() + "\n" + _myAddress;

    private async Task SaveAddresses()
    {
        _busy = true; _message = null;
        try
        {
            _savedAddresses = await Links.SaveAllowedAddressesAsync(await SettingsActor.GetAsync(AuthState, Scopes), _addressesText);
            _addressesText = string.Join("\n", _savedAddresses);
            Say(true, _savedAddresses.Count == 0 ? "Saved: links open from any address." : $"Saved: links open only from {string.Join(", ", _savedAddresses)}.");
        }
        catch (InvalidOperationException ex) { Say(false, ex.Message); }
        finally { _busy = false; }
    }

    private async Task Create()
    {
        _busy = true; _message = null; _newUrl = null; _copiedId = null;
        try
        {
            var key = await Links.CreateAsync(await SettingsActor.GetAsync(AuthState, Scopes), _label, _slug, _newShowHeader);
            _newUrl = $"{Nav.BaseUri}view/{key}";
            _label = ""; _slug = ""; _newShowHeader = true;
            _rows = await Links.ListAsync();
        }
        catch (InvalidOperationException ex) { Say(false, ex.Message); }
        finally { _busy = false; }
    }

    private string? UrlOf(PublishedLink link) => Links.KeyOf(link) is { } key ? $"{Nav.BaseUri}view/{key}" : null;

    private async Task Copy(string? url, int id)
    {
        if (_module is not null && url is not null && await _module.InvokeAsync<bool>("copy", url)) _copiedId = id;
    }

    private async Task SetHeader(int id, bool show)
    {
        _message = null;
        try
        {
            await Links.SetHeaderAsync(await SettingsActor.GetAsync(AuthState, Scopes), id, show);
            _rows = await Links.ListAsync();
            Say(true, show ? "Header shown - an open tab follows within a minute." : "Header hidden - an open tab follows within a minute.");
        }
        catch (InvalidOperationException ex) { Say(false, ex.Message); }
    }

    private async Task Revoke(int id)
    {
        _message = null;
        try
        {
            await Links.RevokeAsync(await SettingsActor.GetAsync(AuthState, Scopes), id);
            _confirmRevoke = null;
            _rows = await Links.ListAsync();
            Say(true, "Revoked.");
        }
        catch (InvalidOperationException ex) { Say(false, ex.Message); }
    }

    private void Say(bool ok, string message) { _messageOk = ok; _message = message; }

    public async ValueTask DisposeAsync()
    {
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
