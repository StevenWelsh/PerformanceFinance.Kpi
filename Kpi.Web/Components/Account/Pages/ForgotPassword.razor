@page "/account/forgot-password"
@layout EmptyLayout

<PageTitle>Forgot password — Performance Finance KPIs</PageTitle>

<AuthCard Title="Forgot your password?">
    @if (Sent is not null)
    {
        @* The same answer whatever the address: it never says whether an account exists. *@
        <Messages Notice="If that address has an account, an email with a link is on its way. The link works for an hour." />
        <a class="acc-link" href="/account/login">Back to sign in</a>
    }
    else
    {
        <p class="acc-text">Enter your email and we'll send you a link to choose a new password.</p>
        <form method="post" action="/account/forgot-password">
            <AntiforgeryToken />
            <label class="login-label" for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" autofocus required />
            <button type="submit" class="login-button">Send link</button>
            <a class="acc-link" href="/account/login">Back to sign in</a>
        </form>
    }
</AuthCard>

@code {
    [SupplyParameterFromQuery(Name = "sent")] public string? Sent { get; set; }
}
