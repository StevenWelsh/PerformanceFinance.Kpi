@page "/account/reset-password"
@layout EmptyLayout
@using Kpi.Data.Auth
@using Microsoft.AspNetCore.Identity
@inject UserManager<KpiUser> Users

<PageTitle>Choose a new password — Performance Finance KPIs</PageTitle>

<AuthCard Title="Choose a new password">
    @if (_user is null)
    {
        <Messages Notice="This link can't be used: it lasts an hour and works once. Ask for another from the sign-in page." />
        <a class="acc-link" href="/account/forgot-password">Send another link</a>
    }
    else
    {
        <Messages Error="@ErrorText" />
        <form method="post" action="/account/reset-password">
            <AntiforgeryToken />
            <input type="hidden" name="userId" value="@UserId" />
            <input type="hidden" name="code" value="@Code" />
            <PasswordInput Id="password" Name="password" Label="New password" Autocomplete="new-password" />
            <PasswordInput Id="confirm" Name="confirmPassword" Label="Confirm password" Autocomplete="new-password" />
            <p class="acc-hint">@Messages.PasswordRules</p>
            @if (_user.TwoFactorEnabled)
            {
                @* an emailed link alone is not enough: the phone proves it too *@
                <label class="login-label" for="code">Code from your authenticator app</label>
                <input id="code" name="authenticatorCode" class="acc-code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required />
            }
            <button type="submit" class="login-button" data-busy-text="Saving…">Save password</button>
        </form>
    }
</AuthCard>

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private KpiUser? _user;

    private string? ErrorText => Error switch
    {
        "match" => "Those passwords don't match.",
        "rules" => "That password isn't strong enough. " + Messages.PasswordRules,
        "code" => "That authenticator code wasn't recognised. Try the one showing now.",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code)) return;
        var user = await Users.FindByIdAsync(UserId);
        if (user is not null && user.DisabledUtc is null) _user = user;
    }
}
