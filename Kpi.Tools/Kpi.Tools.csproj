<Project Sdk="Microsoft.NET.Sdk">

  <!-- The KPI database's command line, as DavidsonHR's DataTools: "migrate" applies CMS_KPI's migrations and
       "compare" checks every report against the current CMS WebKPI version. Run by a person, never by an app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- a label, not a secret: each developer's connection strings live in their own profile, outside the repo -->
    <UserSecretsId>9c1d6f3e-7f5b-4a31-9b8e-2c4a6e0d5f71</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kpi.Data\Kpi.Data.csproj" />
  </ItemGroup>

  <!-- export-apply / export-check: the KPI_Export script and the version Kpi.Push expects, both owned by Kpi.Push -->
  <ItemGroup>
    <Compile Include="..\Kpi.Push\Export\ExportVersion.cs" Link="Export\ExportVersion.cs" />
    <EmbeddedResource Include="..\Kpi.Push\Export\KPI_Export.sql" Link="Export\KPI_Export.sql" LogicalName="KPI_Export.sql" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
